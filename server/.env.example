# Copy to .env and change both values (8+ characters each, use long random strings).
# Device key: the game sends it with every sync (enter the same key in the game's parent settings).
STUDYGAME_DEVICE_KEY=change-me-long-random-key
# Password for the parent dashboard login.
STUDYGAME_ADMIN_PASSWORD=change-me-strong-password
# 1 = the login cookie is only sent over HTTPS (keep 1 behind Caddy; set 0 only for testing on http://).
STUDYGAME_SECURE_COOKIE=1
# Time zone used for "today" / "this week" (should match the kids' phones).
TZ=Asia/Gaza
# Port on this machine (127.0.0.1 only) that the HTTPS proxy forwards to. Change it if 8090 is taken.
STUDYGAME_PORT=8090
# Your (sub)domain, only used by the optional Caddy container (docker compose --profile https up -d).
STUDYGAME_DOMAIN=study.example.com
